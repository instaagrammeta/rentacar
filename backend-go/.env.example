# Rentacar CRM — Go backend environment variables.
# Copy to .env and adjust as needed. docker-compose reads this automatically.

# Environment: development | production
RENTACAR_ENV=production

# HTTP server
RENTACAR_HOST=0.0.0.0
RENTACAR_PORT=5000

# Security
RENTACAR_SECRET_KEY=change-me-in-production
RENTACAR_JWT_SECRET=change-me-too
RENTACAR_JWT_HOURS=12

# PostgreSQL connection
RENTACAR_DATABASE_URI=postgres://rentacar:rentacar@postgres:5432/rentacar?sslmode=disable
POSTGRES_USER=rentacar
POSTGRES_PASSWORD=rentacar
POSTGRES_DB=rentacar

# Redis
RENTACAR_REDIS_ADDR=redis:6379
RENTACAR_REDIS_PASSWORD=
RENTACAR_REDIS_DB=0
RENTACAR_REDIS_ENABLED=true

# Seeding (admin/admin123 + demo data on first launch)
RENTACAR_AUTO_SEED=true
RENTACAR_SEED_DEMO=true

# Backups
RENTACAR_ENABLE_BACKUPS=true
RENTACAR_BACKUP_RETENTION=30

# CORS (comma separated origins or *)
RENTACAR_CORS_ORIGINS=*
