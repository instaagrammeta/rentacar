# Пример переменных окружения для Rentacar CRM backend.
# Скопируйте в .env и при необходимости измените значения.

RENTACAR_ENV=development
RENTACAR_SECRET_KEY=change-me-in-production
RENTACAR_JWT_SECRET=change-me-too
# RENTACAR_DATABASE_URI=sqlite:///./data/rentacar.db
# RENTACAR_DATA_DIR=./data
# RENTACAR_BACKUP_DIR=../backups
RENTACAR_ENABLE_BACKUPS=true
RENTACAR_BACKUP_RETENTION=30
RENTACAR_JWT_HOURS=12
